# Copy to .env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=wisdom_app
DB_PASSWORD=change_me
DB_NAME=wisdom

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_long_random_string
JWT_REFRESH_SECRET=change_me_different_long_random_string

# --- Storage (added in Phase 6) ---
PDF_STORAGE_ROOT=/var/wisdom-storage

# --- Email / password reset ---
# Leave SMTP_HOST empty in local dev — reset emails are logged to the
# console instead of actually sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@wisdom.local
